PORT=3000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Frontend URL used by eSewa callbacks
CLIENT_URL=http://localhost:5173
# Public backend URL. For local eSewa testing use a public HTTPS tunnel such as ngrok.
SERVER_URL=https://your-public-server-url.com

# OpenAI AI Help
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# eSewa ePay V2
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/
